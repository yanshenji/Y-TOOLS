Sub 保存并关闭中控检测结果_分类()
    Dim subFileDir As String
    Dim filePaths As Variant
    Dim i As Integer
    Dim n As Integer
    Dim wb As Workbook
    
    ' 设置文件目录
    subFileDir = "\\10.34.100.50\质量部\赣州寒锐检测数据（每日更新）\(分类)中控检测结果\"
    
    ' 存储所有文件路径（修正了重复项）
    filePaths = Array( _
        subFileDir & "101-105赣州寒锐质量统计报表.xlsx", _
        subFileDir & "102-106赣州寒锐质量统计报表.xlsx", _
        subFileDir & "103车间赣州寒锐质量统计报表.xlsx", _
        subFileDir & "104车间赣州寒锐质量统计报表.xlsx", _
        subFileDir & "109-2108赣州寒锐质量统计报表.xlsx", _
        subFileDir & "MHP赣州寒锐质量统计报表.xlsx" _
    )
    n = 0
    
    ' 遍历所有文件并执行保存关闭操作
    For i = LBound(filePaths) To UBound(filePaths)
        On Error Resume Next ' 忽略错误继续执行
        Set wb = Workbooks(filePaths(i)) ' 尝试获取已打开的工作簿
        
        ' 如果工作簿未打开，则尝试打开
        If wb Is Nothing Then
            'MsgBox "未打开文件: " & filePaths(i), vbExclamation, "未打开"
           GoTo endfor
            
        End If
        
        ' 检查工作簿是否成功打开
        If Not wb Is Nothing Then
            wb.Save ' 保存工作簿
            wb.Close SaveChanges:=False ' 关闭工作簿，已保存过所以设为False
            Set wb = Nothing ' 释放对象变量
            n = n + 1
        Else
            MsgBox "无法处理文件: " & filePaths(i), vbExclamation, "文件错误"
        End If
        On Error GoTo 0 ' 恢复错误处理
endfor:
    Next i
    
    MsgBox "处理" & n & "个文件完毕", vbInformation, "完成"
End Sub




